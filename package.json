{
  "name": "@abuzareal/contour-ui",
  "version": "0.5.0",
  "private": false,
  "description": "Editorial React components, themes, restrained motion, and optional Three.js objects.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "RELEASING.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "NEXTJS.md",
    "CONTRACTS.md",
    "PUBLIC-API.md",
    "COMPOSITION.md",
    "FORMS.md",
    "examples/forms",
    "OVERLAYS.md",
    "STYLING.md",
    "SIZE.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js",
      "default": "./dist/three.js"
    },
    "./scroll": {
      "types": "./dist/scroll.d.ts",
      "import": "./dist/scroll.js",
      "default": "./dist/scroll.js"
    },
    "./theme-bootstrap": {
      "types": "./dist/lib/themeBootstrap.d.ts",
      "import": "./dist/lib/themeBootstrap.js",
      "default": "./dist/lib/themeBootstrap.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts-latin.css": "./dist/fonts-latin.css",
    "./scoped.css": "./dist/scoped.css",
    "./scoped-tokens.css": "./dist/scoped-tokens.css",
    "./minimal-reset.css": "./dist/minimal-reset.css",
    "./tokens.json": "./dist/tokens.json",
    "./actions.css": "./dist/actions.css",
    "./forms.css": "./dist/forms.css",
    "./navigation.css": "./dist/navigation.css",
    "./data-display.css": "./dist/data-display.css",
    "./feedback.css": "./dist/feedback.css",
    "./overlays.css": "./dist/overlays.css",
    "./effects.css": "./dist/effects.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src examples --deny-warnings",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "check:package": "node scripts/check-package.mjs",
    "validate": "npm run check:styles && npm run typecheck && npm run lint && npm run build && npm test && npm run test:browser && npm run check:package",
    "prepublishOnly": "node scripts/verify-release.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "test:compat": "node scripts/test-compat.mjs",
    "test:optional": "node scripts/test-optional-consumer.mjs",
    "test:next": "npm run build && node scripts/test-next.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:form-recipes": "node scripts/test-form-recipes.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "measure:size": "node scripts/measure-size.mjs",
    "check:size": "node scripts/measure-size.mjs --check",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "check:styles": "node scripts/build-styles.mjs --check"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "lucide-react": "^1.49.0"
  },
  "peerDependencies": {
    "lenis": "^1.3.26",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "three": "^0.186.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "lenis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.2",
    "lenis": "^1.3.26",
    "oxlint": "^1.81.0",
    "postcss": "8.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.186.1",
    "typescript": "^5.5.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abuzareal/contour-ui.git"
  },
  "homepage": "https://contour.abuzr.in/",
  "bugs": {
    "url": "https://github.com/abuzareal/contour-ui/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "components",
    "design-system",
    "contour-ui"
  ]
}
